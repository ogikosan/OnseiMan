# 秘密情報
.env
.env.*
!.env.example

# 依存・仮想環境
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# ビルド成果物・一時ファイル
dist/
build/
tmp/
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code のローカル設定
.claude/settings.local.json

# OnseiMan: 利用者のデータ（設定・辞書・履歴・録音・ログ）とモデル
config.json
dict.json
logs/
models/
server_data/
browser_profile/
.venv_server/
build_dist/

# Cloudflare の道具が作る手元のキャッシュ（アカウント名などが入る）
.wrangler/
# 友達用 zip の確認に使う、自分の情報の一覧（公開しない）
packaging/private-patterns.txt

# update.bat が残す前の版
backup/

# install が用意する道具と専用の Python
tools/bin/
tools/python/

# インストーラーの署名の設定（Azure の情報）
packaging/installer/signing.json
packaging/installer/signing-metadata.json

# このパソコンでは GPU 版の準備をしない印（利用者が置く）
gpu_host_off
